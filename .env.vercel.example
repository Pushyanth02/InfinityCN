# =============================================================================
# Lemniscate — Vercel Environment Variables
# =============================================================================
# Copy this to Vercel's Environment Variables settings (Project → Settings →
# Environment Variables) or use `vercel env pull` / `vercel env add`.
#
# These variables configure the app for serverless deployment on Vercel with
# Turso (libSQL) as the database backend.
# =============================================================================

# ─── Database (Turso / libSQL) ───────────────────────────────────────────────
# Create a free database at https://turso.tech
# After creating, run: turso db shell <your-db> < prisma/schema-sqlite.sql
#   (or push the schema with: DATABASE_URL=file:./db/custom.db npx prisma db push)
#   then copy the schema to Turso via the shell.

# Turso database URL (format: libsql://<db-name>-<org>.turso.io)
LIBSQL_URL=libsql://your-db-name-your-org.turso.io

# Turso auth token (generate with: turso db tokens create <your-db>)
LIBSQL_AUTH_TOKEN=your-turso-auth-token-here

# NOTE: DATABASE_URL is NOT needed on Vercel — LIBSQL_URL replaces it.
# The SQLite file: path is only used for Docker/local deployments.

# ─── Security ────────────────────────────────────────────────────────────────
# REQUIRED: API key for authenticated access. Must be ≥16 characters.
# Generate one with: openssl rand -base64 32
LEMNISCATE_API_KEY=your-strong-api-key-here-minimum-16-chars

# REQUIRED: Comma-separated list of allowed origins for CORS/CSRF protection.
# Set this to your Vercel deployment URL(s).
# Include preview URLs if you want them to work.
LEMNISCATE_ALLOWED_ORIGINS=https://your-app.vercel.app,https://lemniscate.vercel.app

# ─── Processing ──────────────────────────────────────────────────────────────
# On Vercel, processing happens synchronously in the upload route handler
# (fire-and-forget within the function's lifetime). The embedded background
# poller is automatically disabled when LIBSQL_URL is detected.

# Concurrency for in-request processing (default: 1 on serverless)
# WORKER_CONCURRENCY=1

# ─── Optional ────────────────────────────────────────────────────────────────
# Redis URL for distributed rate limiting (optional — in-memory works on Vercel
# but resets per serverless instance). Use Upstash Redis for serverless Redis.
# REDIS_URL=rediss://default:your-password@your-db.upstash.io:6379

# Upload size limit (default: 25MB)
# MAX_UPLOAD_BYTES=26214400

# ─── Automatically Set by Vercel ─────────────────────────────────────────────
# These are set automatically by Vercel — do NOT configure them manually:
# VERCEL=1
# VERCEL_URL=your-deployment.vercel.app
# NEXT_RUNTIME=nodejs
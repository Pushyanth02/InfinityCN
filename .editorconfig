# EditorConfig — https://editorconfig.org
# Keeps formatting consistent across editors/IDEs. Mirrors the repo's existing
# 2-space, single-quote, no-trailing-comma style enforced by Prettier/ESLint.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 4

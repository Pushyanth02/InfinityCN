    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.2.108",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",

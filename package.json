{
  "name": "lemniscate",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "A local-first AI reading room where documents become living, interactive experiences.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "bunx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next out tsconfig.tsbuildinfo",
    "ci": "bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "framer-motion": "^12.23.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

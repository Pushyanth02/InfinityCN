# =============================================================================
# Lemniscate — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# In development, defaults work out-of-the-box. In production, all variables
# marked [REQUIRED] must be set.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite database file path. Must start with "file:".
DATABASE_URL=file:./db/custom.db

# ─── Security ────────────────────────────────────────────────────────────────
# [REQUIRED in production] API key for authenticated access.
# Must be at least 16 characters. Set this in production to enable auth.
#LEMNISCATE_API_KEY=your-secret-api-key-here

# [REQUIRED in production] Comma-separated list of allowed origins for CORS/CSRF.
# Example: https://app.example.com,https://lemniscate.example.com
#LEMNISCATE_ALLOWED_ORIGINS=https://your-domain.com

# ─── Upload Storage ──────────────────────────────────────────────────────────
# Directory for uploaded documents. Defaults to public/uploads relative to the project root.
#UPLOAD_DIR=/app/uploads

# ─── Worker (Standalone or Embedded) ─────────────────────────────────────────
# Set to 1 to disable the in-process job poller in the Next.js app.
# Set this when running the standalone worker container alongside the app.
#DISABLE_EMBEDDED_WORKER=1

# Worker poll interval in milliseconds (default: 1200 for embedded, 800 for standalone).
#WORKER_POLL_INTERVAL_MS=800

# Number of concurrent jobs a worker will process (default: 2).
#WORKER_CONCURRENCY=2

# Maximum retry attempts for failed jobs (default: 3).
#WORKER_MAX_RETRIES=3

# Worker port (default: 3003).
#WORKER_PORT=3003

# Grace period for in-flight jobs during shutdown, in milliseconds (default: 30000).
#WORKER_SHUTDOWN_GRACE_MS=30000

# Maximum memory (MB) before the worker stops accepting new jobs (default: 1024).
#WORKER_MAX_MEMORY_MB=1024

# ─── Database Backup ─────────────────────────────────────────────────────────
# Set to true to enable automated SQLite backups.
#BACKUP_ENABLED=false

# Directory for database backups (default: ./backups).
#BACKUP_DIR=./backups

# Number of backup files to retain (default: 7).
#BACKUP_RETENTION_COUNT=7

# Backup interval in hours (default: 24).
#BACKUP_INTERVAL_HOURS=24
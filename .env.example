# ── Lemniscate Environment Variables ─────────────────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# In production (Vercel/Render), set these in the platform's env var settings.

# Database — SQLite for local dev, PostgreSQL for production.
# Local dev (SQLite):
DATABASE_URL="file:./db/custom.db"
#
# Production (PostgreSQL) — use one of:
#   Neon:         postgresql://user:pass@ep-xxx.region.aws.neon.tech/lemniscate?sslmode=require
#   Supabase:     postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
#   Render:       (auto-set from the Render PostgreSQL database)
#   AWS RDS:      postgresql://user:pass@db.xxx.region.rds.amazonaws.com:5432/lemniscate
#   Railway:      postgresql://postgres:pass@turntable.proxy.rlwy.net:port/railway
#
# DATABASE_URL="postgresql://user:password@host:5432/lemniscate"

# Auth secret — used to sign session cookies. Generate with: openssl rand -hex 32
# If not set, defaults to DATABASE_URL (fine for dev, MUST set in production).
# LEMNISCATE_AUTH_SECRET="your-random-secret-here"

# AI provider — the z-ai-web-dev-sdk is pre-configured in this environment.
# No API key needed — the SDK handles auth internally.
# In external deployments, you may need to set provider-specific keys.

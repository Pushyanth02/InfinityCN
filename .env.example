# ── Lemniscate Environment Variables ─────────────────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# In production (Vercel/Render), set these in the platform's env var settings.

# Database — SQLite for local dev, PostgreSQL for production.
# Local dev (SQLite):
DATABASE_URL="file:./db/custom.db"
#
# Production (PostgreSQL) — use one of:
#   Neon:         postgresql://user:pass@ep-xxx.region.aws.neon.tech/lemniscate?sslmode=require
#   Supabase:     postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
#   Render:       (auto-set from the Render PostgreSQL database)
#   AWS RDS:      postgresql://user:pass@db.xxx.region.rds.amazonaws.com:5432/lemniscate
#   Railway:      postgresql://postgres:pass@turntable.proxy.rlwy.net:port/railway
#
# DATABASE_URL="postgresql://user:password@host:5432/lemniscate"

# Auth secret — used to sign session cookies. Generate with: openssl rand -hex 32
# If not set, defaults to DATABASE_URL (fine for dev, MUST set in production).
# LEMNISCATE_AUTH_SECRET="your-random-secret-here"

# ── AI provider — OpenRouter (free tier) ─────────────────────────────────────
# Lemniscate talks to OpenRouter's OpenAI-compatible API. Create a free key at
# https://openrouter.ai/keys (no credit card needed for free models).
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
#
# Optional overrides (sensible free defaults are used if unset):
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
#
# Per-bot models — all default to powerful FREE (":free", $0) models:
#   Luma  (Normal Chatbot / "Luna")  → fast, efficient generalist
#   Ouro  (Study Buddy)              → large frontier-reasoning model
#   Ankaa (long-form creative agent) → large model with a big output budget
# OPENROUTER_MODEL_LUMA="inclusionai/ling-3.0-flash:free"
# OPENROUTER_MODEL_OURO="nvidia/nemotron-3-ultra-550b-a55b:free"
# OPENROUTER_MODEL_ANKAA="nvidia/nemotron-3-super-120b-a12b:free"
# OPENROUTER_MODEL="inclusionai/ling-3.0-flash:free"   # default for all other AI routes
#
# Comma-separated free models for automatic fallback if the primary is busy:
# OPENROUTER_FALLBACK_MODELS="openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,openrouter/free"
#
# Optional attribution headers (shown on your OpenRouter dashboard):
# OPENROUTER_SITE_URL="https://lemniscate.app"
# OPENROUTER_SITE_NAME="Lemniscate"

# ── Free-tier limits & pacing ────────────────────────────────────────────────
# OpenRouter enforces free-model limits per ACCOUNT: ~20 requests/minute, and
# 50 requests/day — or 1000/day once the account has ever held >= $10 credit.
# The app paces itself to these ceilings so it uses the full free tier without
# wasting requests on 429s. Defaults assume a credited account (1000/day).
# OPENROUTER_FREE_RPM=20
# OPENROUTER_FREE_RPD=1000          # set to 50 if you have NOT added credit
# OPENROUTER_MAX_QUEUE_MS=12000     # max ms to wait for a per-minute slot

# Per-IP fairness limits (requests/minute). Raise if you have credit + traffic:
# RATE_LIMIT_LUMA_RPM=40
# RATE_LIMIT_OURO_RPM=24
# RATE_LIMIT_ANKAA_RPM=10
# RATE_LIMIT_AI_RPM=30
# RATE_LIMIT_READ_RPM=120
# RATE_LIMIT_GENERAL_RPM=240

# Per-user quotas (fairness between anonymous sessions):
# USER_DAILY_AI_LIMIT=300
# USER_MONTHLY_AI_LIMIT=6000

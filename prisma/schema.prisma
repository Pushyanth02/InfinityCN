// Lemniscate — Prisma schema
// Persistent server-side storage replacing the original IndexedDB-only model.
//
// ── Database Provider ──────────────────────────────────────────────────────
// Default: SQLite (for local development only).
//
// For production, migrate to PostgreSQL (recommended) or a managed alternative
// (Neon, Supabase, AWS RDS, Railway PostgreSQL). Change `provider` to
// "postgresql" and set DATABASE_URL to the Postgres connection string:
//
//   datasource db {
//     provider = "postgresql"
//     url      = env("DATABASE_URL")
//   }
//
// Then run `bun run db:push` to create the schema on the new database.
// The schema is identical for both providers — only the provider line changes.
//
// PostgreSQL benefits: row-level locking, concurrent writes, replicas,
// better indexing (JSONB), analytics queries, horizontal scaling.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id             String   @id @default(cuid())
  userId         String   // owner — enforces user isolation
  title          String
  author         String?
  sourceType     String
  mimeType       String?
  byteSize       Int      @default(0)
  status         String   @default("ready") // ready | processing | error
  error          String?
  warnings       String?  // JSON array of parse warnings from the Core Engine
  summary        String?
  language       String?
  coverGradient  String?
  // Parsed content stored as JSON: chapters → chunks
  contentJson    String?
  chapterCount   Int      @default(0)
  wordCount      Int      @default(0)
  charCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastReadAt     DateTime?
  readingProgress Float   @default(0) // 0..1
  lastChunkIndex Int      @default(0)
  favorite       Boolean  @default(false)
  tags           String   @default("[]") // JSON array of strings
  collection     String?

  bookmarks      Bookmark[]
  annotations    Annotation[]
  activityEvents ActivityEvent[]
  aiScenes       AiScene[]

  @@index([status])
  @@index([createdAt])
  @@index([lastReadAt])
  @@index([userId])
  @@index([favorite])
  @@index([collection])
}

model Bookmark {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  label      String?
  note       String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Annotation {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  start      Int
  end        Int
  text       String
  note       String?
  color      String   @default("brand")
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String?  // owner — enforces per-user activity isolation
  documentId String?
  type       String   // upload | read | bookmark | annotate | ai_summarize | ai_cinematize
  detail     String?
  createdAt  DateTime @default(now())
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([documentId])
  @@index([documentId, createdAt])
  @@index([userId])
  @@index([userId, createdAt])
}

model AiScene {
  id         String   @id @default(cuid())
  documentId String
  ordinal    Int
  title      String
  body       String   
  mood       String?
  characters String?  // JSON array
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Preference {
  id    String @id
  value String
}

/// Tracks AI bot usage for monitoring, rate analytics, and cost estimation.
/// One row per AI request across all bots (luma, ouro, ankaa, + legacy tools).
model UsageEvent {
  id            String   @id @default(cuid())
  userId        String?  // per-user quota tracking
  bot           String   // luma | ouro | ankaa | summarize | scenes | etc.
  documentId    String?
  kind          String   // chat | quiz | flashcards | study_guide | longform | etc.
  tokensEstimate Int     @default(0)  // rough char/4 estimate of prompt+response
  latencyMs     Int      @default(0)
  status        String   @default("ok") // ok | error | rate_limited
  createdAt     DateTime @default(now())

  @@index([bot])
  @@index([createdAt])
  @@index([userId])
}

/// Background AI analysis job for a document. Tracks the deep-analysis
/// pipeline (denoise → summarize → themes → characters → criticism) with
/// progress, ETA, and the sequential results.
model AnalysisJob {
  id          String    @id @default(cuid())
  documentId  String    @unique
  userId      String?   // owner for isolation
  status      String    @default("queued") // queued | running | done | error
  step        String?   // current step: denoise | summary | themes | characters | criticism
  progress    Int       @default(0)  // 0..100
  etaSeconds  Int       @default(0)
  results     String?   // JSON: { summary, themes, characters, criticism, ... }
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

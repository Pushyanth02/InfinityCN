# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# e2e test output reports
e2e-report.txt
e2e-run.txt
e2e-run2.txt
e2e-run3.txt
e2e-run4.txt

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# build output — standalone (47k+ files, rebuilt on demand)
.next/standalone/

# bun lockfiles — deterministic via bun.lock-binary
bun.lock

# auto-generated PID files from dev scripts
.zscripts/dev.pid

# file uploads (local storage)
public/uploads/

# SQLite database files (runtime data — must not be committed).
# Prisma resolves `file:` URLs relative to CWD at runtime and relative to the
# schema at CLI time, which is why both locations can appear.
db/*.db
db/*.db-shm
db/*.db-wal
db/*.db-journal
prisma/db/*.db
prisma/db/*.db-shm
prisma/db/*.db-wal
prisma/db/*.db-journal

# database backups
/backups/
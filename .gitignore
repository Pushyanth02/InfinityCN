# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing & Coverage ─────────────────────────────────────────────────────
/coverage
*.lcov
junit.xml
e2e-report*.txt
e2e-run*.txt

# ─── Next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/
.next/standalone/

# ─── Production Build ────────────────────────────────────────────────────────
/build

# ─── Environment Files ──────────────────────────────────────────────────────
# All .env files are ignored by default.  Only .env.example is committed.
.env*
!.env.example

# ─── OS Files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
._*

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# ─── Certificates & Keys ────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt

# ─── Debug & Log Files ──────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
server.log
dev.log
dev.out.log
dev_test.log

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── AI / Agent Config (user-specific) ──────────────────────────────────────
local-*
.claude
.z-ai-config
.kiro/
test
prompt
agent-ctx/
skills-lock.json

# ─── Skills ──────────────────────────────────────────────────────────────────
/skills/

# ─── Redis (reserved for future rate-limit/queue use) ───────────────────────
dump.rdb
appendonly.aof

# ─── Bun ─────────────────────────────────────────────────────────────────────
bun.lock

# ─── PID Files ───────────────────────────────────────────────────────────────
*.pid
.zscripts/dev.pid

# ─── File Uploads (local storage) ────────────────────────────────────────────
public/uploads/
.tmp-upload-*

# ─── SQLite Database Files ───────────────────────────────────────────────────
# Runtime data — must not be committed.
# Prisma resolves `file:` URLs relative to CWD at runtime and relative to the
# schema at CLI time, which is why both locations can appear.
db/*.db
db/*.db-shm
db/*.db-wal
db/*.db-journal
prisma/db/*.db
prisma/db/*.db-shm
prisma/db/*.db-wal
prisma/db/*.db-journal

# ─── Database Backups ────────────────────────────────────────────────────────
/backups/
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/
/build

# Bun / Node
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma / local database
/db/*.db
/db/*.db-journal
/prisma/*.db

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Editor / OS
.DS_Store
.idea/
.vscode/
*.pem

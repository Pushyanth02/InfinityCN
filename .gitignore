# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing & Coverage ─────────────────────────────────────────────────────
/coverage
*.lcov
junit.xml
e2e-report*.txt
e2e-run*.txt

# ─── Next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/
.next/standalone/

# ─── Production Build ────────────────────────────────────────────────────────
/build

# ─── Environment Files ──────────────────────────────────────────────────────
# All .env files are ignored by default.  Non-secret templates remain tracked.
.env*
!.env*.example

# ─── OS Files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
._*

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# ─── Certificates & Keys ────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt

# ─── Debug & Log Files ──────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
server.log
dev.log
dev.out.log
dev_test.log

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── AI / Agent Config (user-specific) ──────────────────────────────────────
# These are per-developer tooling configs that must not be shared:
#   .claude/        — Claude Code local settings
#   .kiro/          — Kiro IDE steering/hooks
#   .agents/        — agent skill packs (supabase, frontend-design, …)
#   .crush/         — Crush local DB/logs
#   agent-ctx/      — agent context briefs
#   skills-lock.json — agent skill lockfile
#   .z-ai-config    — AI tool config
# Files here may be tracked historically; git rm --cached untracks them
# without deleting the local copy.
/local-*
.claude
.z-ai-config
.kiro/
.agents/
.crush/
test
prompt
agent-ctx/
skills-lock.json
.zscripts/dev.pid

# ─── Local dev helper scripts (per-developer; not part of the build) ────────
# The repo's canonical build/dev entry points live in package.json scripts
# and the Dockerfiles. .zscripts/ are optional local convenience wrappers.
.zscripts/

# ─── Skills ──────────────────────────────────────────────────────────────────
/skills/

# ─── Redis (reserved for future rate-limit/queue use) ───────────────────────
dump.rdb
appendonly.aof

# ─── Bun ─────────────────────────────────────────────────────────────────────
# NOTE: bun.lock IS tracked (Bun is the canonical package manager — see
# CLAUDE.md). Do NOT ignore it. The line below ignores stray per-user Bun
# caches/credentials only.
bun.config.local
bunfig.local.toml

# ─── Lockfiles ───────────────────────────────────────────────────────────────
# Bun is the sole package manager (see CLAUDE.md); bun.lock is the canonical
# lockfile and is tracked. npm/yarn lockfiles are not canonical anywhere —
# Docker, Vercel, and CI all run on Bun — so ignore them everywhere to keep
# them from drifting back in.
package-lock.json
yarn.lock

# ─── PID Files ───────────────────────────────────────────────────────────────
*.pid
.zscripts/dev.pid

# ─── File Uploads (local storage) ────────────────────────────────────────────
public/uploads/
.tmp-upload-*

# ─── SQLite Database Files ───────────────────────────────────────────────────
# Runtime data — must not be committed.
# Prisma resolves `file:` URLs relative to CWD at runtime and relative to the
# schema at CLI time, which is why both locations can appear.
db/*.db
db/*.db-shm
db/*.db-wal
db/*.db-journal
prisma/db/*.db
prisma/db/*.db-shm
prisma/db/*.db-wal
prisma/db/*.db-journal

# ─── Database Backups ────────────────────────────────────────────────────────
/backups/
